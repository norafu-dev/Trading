# Local development only. Do not commit .env or paste tokens into chat.
POSTGRES_USER=trading
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=trading
DISCORD_TOKEN=
LOG_LEVEL=INFO

# Cloudflare R2 私有 Standard 桶；密钥只填本地 .env，不发送到聊天。
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 本项目归档对象达到 8 GB 时提醒；不会自动删除或停止归档。
MEDIA_WARNING_BYTES=8000000000
# 单文件下载上限 25 MB，超出后面板显示失败。
MEDIA_MAX_IMAGE_BYTES=25000000
# 消息页时效提示窗口，单位秒；不是交易执行规则。
MESSAGE_FRESHNESS_SECONDS=120
